# ===================================================================
# MediAssist-AI Root Environment Variables (.env.example)
# ===================================================================

# --- Docker Compose / Infrastructure ---
DB_USER=postgres
DB_PASSWORD=postgres_secure_2026
DB_NAME=mediassist_db
DB_PORT=5433
REDIS_PORT=6379

# --- Backend Application ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5000
JWT_SECRET=dev_super_secret_jwt_key_mediassist_telehealth_platform_2026_very_long_secure_string_needs_256_bits!

# --- AI Gateways ---
# Google Gemini 1.5 Flash (Tier 1 AI Gateway) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter Free Tier Fallback Pool (Tier 2 AI Gateway) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# --- Supabase Cloud Storage (Dual-Tier EMR) ---
SUPABASE_URL=https://wakgzrzchmqdqyrgxlaq.supabase.co
# SUPABASE_KEY phai la service_role key (Dashboard -> Project Settings -> API -> service_role).
# CHI dat key that trong backend/.env (da .gitignore). Bo trong => tep y te luu local /uploads/ (fallback dev).
# Bucket phai la PRIVATE: tep chi xem qua signed URL 15 phut (app.storage.signed-url-ttl-seconds).
SUPABASE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_ENABLED=true
APP_STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- Frontend Application ---
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:5001
VITE_APP_TITLE=MediAssist-AI Telehealth & Clinical AI Platform

# --- Google OAuth2 (Social Login) ---
# Tạo tại: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs: http://localhost:5001/login/oauth2/code/google
# Authorized JavaScript origins: http://localhost:5001, http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

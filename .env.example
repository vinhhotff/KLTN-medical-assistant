# ===================================================================
# MediAssist-AI Environment Variables Configuration (.env)
# ===================================================================

# OpenRouter Free-Tier AI Gateway API Key (Lấy key miễn phí tại: https://openrouter.ai/keys)
# Mô hình miễn phí sử dụng: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free
OPENROUTER_API_KEY=

# Supabase Cloud Storage (Tùy chọn)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_ENABLED=false

# ===================================================================
# MediAssist-AI Master Environment Variables Template (.env.example)
# Sao chép tệp này thành `.env` (hoặc `backend/.env`) — KHÔNG commit khóa thật.
# ===================================================================

# --- 1. Docker Compose & Cơ Sở Dữ Liệu Hạ Tầng ---
DB_USER=postgres
DB_PASSWORD=postgres_secure_2026
DB_NAME=mediassist_db
DB_PORT=5433
REDIS_HOST=localhost
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- 2. Ứng Dụng Backend Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5001
JWT_SECRET=dev_super_secret_jwt_key_mediassist_telehealth_platform_2026_very_long_secure_string_needs_256_bits!
APP_JWT_SECRET=dev_super_secret_jwt_key_mediassist_telehealth_platform_2026_very_long_secure_string_needs_256_bits!
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_CLIENT_BASE_URL=http://localhost:5173

# --- 3. Cổng AI Gateways (Gemini & OpenRouter) ---
# Google Gemini Direct AI Gateway (Priority 1) - Lấy API key tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter Free-Tier AI Gateway Fallback (Priority 2) - Lấy key tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# AI FinOps Currency Exchange Rate (VND per USD)
AI_COST_VND_PER_USD=25450

# Dung lượng quét PDF tối đa (số trang)
APP_PDF_MAX_PAGES=10

# --- 4. Lưu Trữ Đám Mây Supabase Cloud Storage (Private Bucket) ---
SUPABASE_URL=https://wakgzrzchmqdqyrgxlaq.supabase.co
# SUPABASE_KEY phải là service_role key (Dashboard -> Project Settings -> API -> service_role).
# CHỈ đặt key thật trong backend/.env (đã .gitignore). Để trống => tệp y tế tự động fallback lưu local /uploads/ (an toàn dev).
# Bucket 'medical-documents' là PRIVATE: tệp y tế chỉ được xem qua signed URL hết hạn sau 15 phút.
SUPABASE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_ENABLED=true
APP_STORAGE_SIGNED_URL_TTL_SECONDS=900

# --- 5. Cổng Thanh Toán & Môi Trường Sandbox ---
# Cờ bật Mock Payment Sandbox (true cho dev/demo; bắt buộc đặt false trên production)
APP_PAYMENT_MOCK_ENABLED=true

# Stripe Sandbox API Credentials - https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_mock_sandbox_key_mediassist_2026
STRIPE_PUBLISHABLE_KEY=pk_test_mock_sandbox_key_mediassist_2026
STRIPE_WEBHOOK_SECRET=whsec_mock_sandbox_secret

# --- 6. Hệ Thống Email Giao Dịch & Xác Thực (SMTP) ---
# Dev: Sử dụng Mailpit (docker compose up -d): SMTP localhost:1025, xem mail tại http://localhost:8025
# Prod: Cấu hình SMTP của bệnh viện hoặc Gmail SMTP với STARTTLS
APP_MAIL_ENABLED=true
APP_MAIL_FROM=MediAssist AI <no-reply@mediassist.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# --- 7. Đăng Nhập Mạng Xã Hội Google OAuth2 ---
# Tạo tại: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:5001/login/oauth2/code/google
# Authorized JavaScript origins: http://localhost:5001, http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth2/callback
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?error=oauth2_failed

# --- 8. Ứng Dụng Frontend React (Vite) ---
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:5001
VITE_APP_NAME=MediAssist-AI
VITE_APP_DESCRIPTION=Nền Tảng Trợ Lý Y Khoa & Phân Luồng Lâm Sàng Trực Tuyến
VITE_APP_VERSION=2.2.0

# Cấu hình Demo Bảo Vệ Tốt Nghiệp (Capstone Defense):
#  - VITE_ENABLE_DEMO_LOGIN: Bật nút đăng nhập nhanh với tài khoản mẫu (Patient, Doctor, Admin) trên /login
#  - VITE_ENABLE_DEV_TOOLS: Hiển thị thanh công tắc chế độ AI Online/Offline trực tiếp trên trang tìm bác sĩ
#  (Người dùng cũng có thể mở thanh công cụ demo bất kỳ lúc nào bằng phím tắt Ctrl+Shift+D hoặc Cmd+Shift+D)
VITE_ENABLE_DEMO_LOGIN=false
VITE_ENABLE_DEV_TOOLS=false

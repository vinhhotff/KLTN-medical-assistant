# ===================================================================
# MediAssist-AI Backend Environment Variables (.env.example)
# Sao chép tệp này thành `backend/.env` — KHÔNG commit khóa thật.
# ===================================================================

# --- 1. Cấu Hình Ứng Dụng Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5001

# --- 2. Cơ Sở Dữ Liệu PostgreSQL (Docker pgvector :5433) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mediassist_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secure_2026

# --- 3. Bộ Nhớ Đệm Phân Tán Redis (Docker :6379) ---
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# --- 4. Bảo Mật Xác Thực & CORS ---
APP_JWT_SECRET=dev_super_secret_jwt_key_mediassist_telehealth_platform_2026_very_long_secure_string_needs_256_bits!
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- 5. Cổng AI Gateways (Gemini & OpenRouter) ---
# Google Gemini Direct AI Gateway (Priority 1) - https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter Free-Tier Fallback Pool (Priority 2) - https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key

# AI FinOps Currency Exchange Rate (VND per USD)
AI_COST_VND_PER_USD=25450

# --- 6. Lưu Trữ Đám Mây Supabase Cloud Storage (Private Bucket) ---
SUPABASE_URL=https://wakgzrzchmqdqyrgxlaq.supabase.co
# SUPABASE_KEY phải là service_role key (Dashboard -> Project Settings -> API -> service_role).
# CHỈ đặt key thật trong backend/.env (đã .gitignore). Để trống => tệp y tế lưu local /uploads/ (fallback dev).
# Bucket 'medical-documents' là PRIVATE: tệp y tế chỉ được xem qua signed URL hết hạn sau 15 phút.
SUPABASE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_ENABLED=true
APP_STORAGE_SIGNED_URL_TTL_SECONDS=900

# Giới hạn số trang PDF quét tối đa
APP_PDF_MAX_PAGES=10

# --- 7. Cổng Thanh Toán & Môi Trường Sandbox ---
# Cờ bật Mock Payment Sandbox (true cho dev/demo; bắt buộc đặt false trên production)
APP_PAYMENT_MOCK_ENABLED=true

# Stripe Sandbox API Credentials - https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_mock_sandbox_key_mediassist_2026
STRIPE_PUBLISHABLE_KEY=pk_test_mock_sandbox_key_mediassist_2026
STRIPE_WEBHOOK_SECRET=whsec_mock_sandbox_secret

# --- 8. Đăng Nhập Mạng Xã Hội Google OAuth2 ---
# Authorized redirect URI: http://localhost:5001/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth2/callback
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?error=oauth2_failed

# Frontend base URL dùng trong link email (reset mật khẩu, xác thực email)
APP_CLIENT_BASE_URL=http://localhost:5173

# --- 9. Hệ Thống Email Giao Dịch & Xác Thực (SMTP) ---
# Dev: Sử dụng Mailpit (docker compose up -d): SMTP localhost:1025, xem mail tại http://localhost:8025
# Prod: Cấu hình SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD với STARTTLS
APP_MAIL_ENABLED=true
APP_MAIL_FROM=MediAssist AI <no-reply@mediassist.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ===================================================================
# MediAssist-AI Backend Environment Variables (.env.example)
# ===================================================================

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=5000

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/mediassist_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_secure_2026

SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

APP_JWT_SECRET=dev_super_secret_jwt_key_mediassist_telehealth_platform_2026_very_long_secure_string_needs_256_bits!
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

GEMINI_API_KEY=
OPENROUTER_API_KEY=your-openrouter-api-key

SUPABASE_URL=https://wakgzrzchmqdqyrgxlaq.supabase.co
# SUPABASE_KEY: KHUYEN NGHI dung Secret key moi dang sb_secret_... (Dashboard -> Project Settings -> API Keys -> Secret keys).
#   sb_secret_... chi duoc gui qua header apikey (backend tu xu ly). Key service_role JWT cu (eyJ...) van ho tro nhung nen thay the.
# CHI dat key that trong backend/.env (da .gitignore). Bo trong => tep y te luu local /uploads/ (fallback dev).
# Bucket phai la PRIVATE: tep chi xem qua signed URL 15 phut (app.storage.signed-url-ttl-seconds).
SUPABASE_KEY=
SUPABASE_BUCKET=medical-documents
SUPABASE_ENABLED=true
APP_STORAGE_SIGNED_URL_TTL_SECONDS=900

APP_PDF_MAX_PAGES=10

# Google OAuth2 - redirect URI: http://localhost:5001/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
APP_OAUTH2_SUCCESS_REDIRECT_URI=http://localhost:5173/oauth2/callback
APP_OAUTH2_FAILURE_REDIRECT_URI=http://localhost:5173/login?error=oauth2_failed

# Frontend base URL dung trong link email (reset mat khau, xac thuc email)
APP_CLIENT_BASE_URL=http://localhost:5173

# Email - dev dung Mailpit (docker compose up -d): SMTP localhost:1025, xem mail tai http://localhost:8025
# Prod: dat SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD (STARTTLS bat buoc)
APP_MAIL_ENABLED=true
APP_MAIL_FROM=MediAssist AI <no-reply@mediassist.local>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=

# ===================================================================
# MediAssist-AI Frontend Environment Variables (.env.example)
# Copy to .env.local — never commit real secrets.
# ===================================================================

VITE_API_BASE_URL=/api/v1
# Backend dev profile runs on port 5001 (see backend application-dev.properties).
# Used for the Google OAuth2 redirect, which bypasses the Vite proxy.
VITE_BACKEND_URL=http://localhost:5001

VITE_APP_NAME=MediAssist-AI
VITE_APP_DESCRIPTION=Nền Tảng Trợ Lý Y Khoa & Phân Luồng Lâm Sàng Trực Tuyến
VITE_APP_VERSION=1.0.0

# Demo/staging builds only (capstone defense):
#  - quick login with seeded demo accounts + sample registration data on /login
#    (quick login is always on in `npm run dev`);
#  - the "Công cụ demo · Chế độ AI toàn hệ thống" switch on the doctor search page
#    for every role (NOT enabled by `npm run dev`).
# Without this flag the switch can still be unlocked per tab with Ctrl+Shift+D
# (Cmd+Shift+D on macOS). Backend only lets ADMIN call POST /system/ai-mode/toggle (BE-1).
VITE_ENABLE_DEMO_LOGIN=false

# Expose developer tools to non-admin users (e.g. the system-wide AI offline switch).
# Keep false in any shared environment: the switch affects every user.
VITE_ENABLE_DEV_TOOLS=false
